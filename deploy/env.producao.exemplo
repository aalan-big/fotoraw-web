# apps/server/.env de PRODUÇÃO — copie pra apps/server/.env e preencha.
# Nunca commite o .env preenchido.

# ---- app ----
NODE_ENV=production
# mesma porta de PORTA_API em deploy/.env.nuxt
PORT=4001
WEB_URL=https://SEU-DOMINIO
FOTOGRAFO_URL=https://painel.SEU-DOMINIO
ADMIN_URL=https://admin.SEU-DOMINIO

# ---- banco (a URL completa sai no final do instalar-vps.sh; container Docker db_fotoraw = porta 5433) ----
DATABASE_URL=postgresql://fotoraw:SENHA_DO_BANCO@127.0.0.1:5433/fotoraw
DIRECT_URL=postgresql://fotoraw:SENHA_DO_BANCO@127.0.0.1:5433/fotoraw
# Supabase em vez do local? DATABASE_URL = pooler (6543), DIRECT_URL = direta (5432).

# ---- redis (ainda não usado; deixe assim) ----
REDIS_URL=redis://localhost:6379

# ---- auth ----
# gere: openssl rand -base64 48
JWT_SECRET=TROQUE-POR-48-BYTES-ALEATORIOS
JWT_EXPIRES_IN=15m
SESSAO_REFRESH_DIAS=7
SESSAO_ADMIN_HORAS=12
TOKEN_API_DIAS=365
# admin sem 2FA não entra (padrão true em produção)
ADMIN_EXIGE_2FA=true

# ---- storage (fotos) — entra com o módulo sync; placeholders por enquanto ----
STORAGE_ENDPOINT=https://placeholder.invalid
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=placeholder
STORAGE_SECRET_KEY=placeholder
STORAGE_BUCKET_PREVIEWS=previews
STORAGE_BUCKET_ORIGINAIS=originais
STORAGE_PREVIEWS_URL_PUBLICA=https://placeholder.invalid/previews

# ---- pagamentos (passo 6 do fotógrafo) ----
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- e-mail (Resend) — vazio = e-mails só no log ----
RESEND_API_KEY=
EMAIL_REMETENTE=FotoRAW <no-reply@SEU-DOMINIO>

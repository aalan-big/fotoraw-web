# URLs públicas que entram no build dos apps Nuxt (web, fotografo, admin).
# Copie pra deploy/.env.nuxt (o publicar.sh carrega antes do build).
NUXT_PUBLIC_API_BASE=https://api.SEU-DOMINIO/api
NUXT_PUBLIC_WEB_URL=https://SEU-DOMINIO
NUXT_PUBLIC_FOTOGRAFO_URL=https://painel.SEU-DOMINIO

# Portas internas dos 4 processos (mude se já houver algo nelas — veja diagnostico.sh).
# A porta da API tem que ser a mesma do PORT em apps/server/.env.
PORTA_WEB=4000
PORTA_API=4001
PORTA_PAINEL=4002
PORTA_ADMIN=4003

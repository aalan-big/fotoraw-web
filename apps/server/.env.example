# ---- app ----
NODE_ENV=development
PORT=3001
# URL pública da vitrine (CORS, links em e-mail)
WEB_URL=http://localhost:3000

# ---- banco ----
# Postgres local do `npm run db` (prisma dev, sem Docker). Com Docker: postgresql://fotoraw:fotoraw@localhost:5432/fotoraw
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fotoraw?sslmode=disable

# ---- redis / fila ----
REDIS_URL=redis://localhost:6379

# ---- auth ----
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=7d

# ---- storage (R2 / MinIO em dev) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=fotoraw
STORAGE_SECRET_KEY=fotoraw123
STORAGE_BUCKET_PREVIEWS=previews
STORAGE_BUCKET_ORIGINAIS=originais
# URL pública do bucket de previews (em prod: domínio do R2)
STORAGE_PREVIEWS_URL_PUBLICA=http://localhost:9000/previews

# ---- pagamento (Asaas) ----
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# comissão da plataforma no cenário evento (0.10 = 10%)
COMISSAO_PLATAFORMA=0.10

# ---- e-mail (Resend) ----
RESEND_API_KEY=
EMAIL_REMETENTE=FotoRAW <no-reply@fotoraw.com.br>

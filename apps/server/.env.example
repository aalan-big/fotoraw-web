# ---- app ----
NODE_ENV=development
PORT=3001
# URL pública da vitrine (CORS, links em e-mail)
WEB_URL=http://localhost:3000
# painel do fotógrafo e admin (links de e-mail, CORS)
FOTOGRAFO_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003

# ---- banco (Supabase) ----
# Painel do projeto → Connect → ORMs → Prisma. Troque [SENHA] e [REF].
# Runtime: Session pooler (IPv4, porta 5432 no host do pooler)
DATABASE_URL=postgresql://postgres.[REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Migrations/seed: a conexão direta (db.[REF].supabase.co) é só IPv6 — sem IPv6 na rede, use o mesmo Session pooler
DIRECT_URL=postgresql://postgres.[REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Sem Supabase (Postgres local do `npm run db`): use a mesma URL nas duas
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fotoraw?sslmode=disable
# DIRECT_URL=postgresql://postgres:postgres@localhost:5433/fotoraw?sslmode=disable

# ---- redis / fila ----
REDIS_URL=redis://localhost:6379

# ---- auth ----
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=15m
SESSAO_REFRESH_DIAS=7
# refresh do admin (cookie some ao fechar o navegador)
SESSAO_ADMIN_HORAS=12
# admin sem 2FA nao acessa /admin/* (padrao: true em producao, false fora)
# ADMIN_EXIGE_2FA=true
TOKEN_API_DIAS=365

# ---- storage (R2 / MinIO em dev) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=fotoraw
STORAGE_SECRET_KEY=fotoraw123
STORAGE_BUCKET_PREVIEWS=previews
STORAGE_BUCKET_ORIGINAIS=originais
# URL pública do bucket de previews (em prod: domínio do R2)
STORAGE_PREVIEWS_URL_PUBLICA=http://localhost:9000/previews

# ---- pagamento ----
# Mercado Pago: vendas de evento (marketplace; o fotógrafo conecta a conta dele por OAuth)
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Stripe: assinatura de plano (cartão)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# chave de 32 bytes em base64 pra cifrar tokens OAuth (gere: openssl rand -base64 32)
CHAVE_CIFRA_TOKENS=
# comissão da plataforma no cenário evento (0.10 = 10%)
COMISSAO_PLATAFORMA=0.10

# ---- e-mail (Resend) ----
RESEND_API_KEY=
EMAIL_REMETENTE=FotoRAW <no-reply@fotoraw.com.br>
